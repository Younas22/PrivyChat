# ---------- Database (MySQL / MariaDB) ----------
# Local XAMPP:   mysql://root:@localhost:3306/privychat
# Hostinger:     mysql://USER:PASSWORD@REMOTE_HOST:3306/DATABASE   (Remote MySQL must allow access)
# Add ?ssl=true at the end if your provider requires TLS.
DATABASE_URL="mysql://root:@localhost:3306/privychat"
# Max DB connections per server instance (keep small on serverless/shared hosting)
# Seconds before idle connections close (must be below the server wait_timeout)
DB_IDLE_TIMEOUT_SECONDS=15
DB_CONNECTION_LIMIT=3

# ---------- Realtime (Pusher Channels) ----------
# Leave empty to use the built-in single-server SSE (local development).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ---------- File storage ----------
# Vercel Blob: set automatically when you connect a Blob store to the Vercel project.
# Leave empty to store files on local disk in STORAGE_DIR.
BLOB_READ_WRITE_TOKEN=
# Must match the Blob store setting: private (default) or public
BLOB_ACCESS=private
STORAGE_DIR="storage/uploads"

# Upload limits in megabytes
MAX_IMAGE_MB=10
MAX_VIDEO_MB=500
MAX_DOCUMENT_MB=500
MAX_AUDIO_MB=25

# ---------- Admin (/admin) ----------
# Admin email and password. Admin login is disabled until ADMIN_PASSWORD (8+ characters) is set.
ADMIN_EMAIL=098765@oooo.co
ADMIN_PASSWORD=
# Optional: secret for signing session cookies (any long random string)
APP_SECRET=

# Live video (watching a recording as it happens) tries a direct WebRTC connection first; when
# that's impossible (different networks) it automatically relays short pieces through this app's
# own server + storage, so NOTHING below is required. A TURN server is optional: it keeps the
# delay under a second on those networks instead of ~3-5 s. Pick ONE (read at runtime):
# 1) Cloudflare Realtime TURN (free tier): dash.cloudflare.com > Realtime > TURN Server > Create
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# 2) Metered.ca (free tier): the credentials URL from your dashboard
# METERED_TURN_URL=https://<your-app>.metered.live/api/v1/turn/credentials?apiKey=<key>
# 3) Your own TURN (e.g. coturn), static JSON RTCIceServer[]
# ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]'
